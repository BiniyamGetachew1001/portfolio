# Cloudflare R2 credentials
# Get these from: Cloudflare Dashboard → R2 → Manage R2 API Tokens
R2_ACCOUNT_ID=your_account_id_here
R2_ACCESS_KEY_ID=your_access_key_id_here
R2_SECRET_ACCESS_KEY=your_secret_access_key_here
R2_BUCKET_NAME=your_bucket_name_here

# Public CDN base URL for the reels folder
# After making your R2 bucket public (or setting a custom domain),
# set this to the base URL — NO trailing slash.
# Examples:
#   https://pub-xxxxxxxxxxxx.r2.dev/reels
#   https://cdn.yourdomain.com/reels
VITE_REELS_CDN_URL=https://pub-xxxxxxxxxxxx.r2.dev/reels
