# ── Cloudinary (recommended — free 25GB, global CDN, auto-compression) ──────
# Sign up free at https://cloudinary.com (no credit card)
# Get these from: Cloudinary Dashboard → API Keys
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ── Shared: CDN base URL used by the portfolio ───────────────────────────────
# Set this after uploading. For Cloudinary it looks like:
#   https://res.cloudinary.com/YOUR_CLOUD_NAME/video/upload/q_auto,vc_auto/reels
# NO trailing slash.
VITE_REELS_CDN_URL=https://res.cloudinary.com/your_cloud_name/video/upload/q_auto,vc_auto/reels

# ── Cloudflare R2 (alternative) ──────────────────────────────────────────────
# R2_ACCOUNT_ID=your_account_id_here
# R2_ACCESS_KEY_ID=your_access_key_id_here
# R2_SECRET_ACCESS_KEY=your_secret_access_key_here
# R2_BUCKET_NAME=your_bucket_name_here
